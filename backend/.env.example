# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=wellsync

# Pinecone (chat history)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=wellsync-chat

# LLM Configuration (Groq is recommended for ultra-fast, high-quality responses)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback to local Ollama if LLM_PROVIDER=ollama or no Groq key
LLM_API_URL=http://localhost:11434/api/generate
LLM_MODEL=llama3

# TMDB Configuration (The Movie Database for movie posters and recommendations)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2
